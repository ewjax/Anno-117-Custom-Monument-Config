
<ModOps>

    <!--
    ==========================================================================================
    Customizable Options for Monument Events:
        - Colosseum Preparation Time Multiplier
        - Colosseum Event Duration Multiplier
        - Hippodrome Preparation Time Multiplier
        - Hippodrome Event Duration Multiplier
        - Hippodrome Event Cooldown Multiplier
        - Hippodrome Race Splendor Pot Multiplier
        - Honoured Guest Visit Multiplier
        - Honoured Guest Heroic Percent Chance Per Splendor Stage

    ========================================================================================== -->

    <!--
    ==========================================================================================
    Colosseum
    ========================================================================================== -->

    <!-- Colosseum Preparation Time, EventDuration Time -->
    <ModOp GUID="40562,40563,40564" Type="Merge" Path="/Values/MonumentEvent">
        <!--
            <ModValue Insert="0.5 * self::node()"/>
            <ModValue Insert="$colosseum_preparationtime_multiplier * self::node()"/>
            <ModValue Insert="$colosseum_eventduration_multiplier * self::node()"/>
        -->
        <PreparationTime>
            <ModValue Insert="$colosseum_preparationtime_multiplier * self::node()"/>
        </PreparationTime>
        <EventDuration>
            <ModValue Insert="$colosseum_eventduration_multiplier * self::node()"/>
        </EventDuration>
    </ModOp>



    <!--
    ==========================================================================================
    Hippodrome
    ========================================================================================== -->

    <!-- Hippodrome Preparation Time, EventDuration Time -->
    <ModOp GUID="154437,154438,154439" Type="Merge" Path="/Values/MonumentEvent">
        <!--
            <ModValue Insert="0.5 * self::node()"/>
            <ModValue Insert="$hippodrome_preparationtime_multiplier * self::node()"/>
            <ModValue Insert="$hippodrome_eventduration_multiplier * self::node()"/>
            <ModValue Insert="$hippodrome_cooldown_multiplier * self::node()" />
            <ModValue Insert="$hippodrome_splendorpot_multiplier * self::node()" />
        -->
        <PreparationTime>
            <ModValue Insert="$hippodrome_preparationtime_multiplier * self::node()"/>
        </PreparationTime>
        <EventDuration>
            <ModValue Insert="$hippodrome_eventduration_multiplier * self::node()"/>
        </EventDuration>
    </ModOp>

    <!-- Hippodrome Cooldown Time -->
    <ModOp Merge="@152714/BuildingRank/CooldownPerRank/Item">
        <Cooldown>
            <ModValue Insert="$hippodrome_cooldown_multiplier * self::node()" />
        </Cooldown>
    </ModOp>

    <!-- Hippodrome Splendor Pot -->
    <ModOp Merge="@152714/MonumentEventBuilding/SplendorWinningsPot/RewardSplit/*/TotalSplendorPot">
        <ModValue Insert="$hippodrome_splendorpot_multiplier * self::node()" />
    </ModOp>


    <!--
    ==========================================================================================
    Honoured Guest
    ========================================================================================== -->

    <!-- Honoured Guest Visit Time Multiplier -->
    <ModOp Merge="@173079/VisitorsConfig/DeliveryTimeByCityLevel/Item/Time">
        <!--
            <ModValue Insert="0.5 * self::node()" />
            <ModValue Insert="$honoured_guest_visit_multiplier * self::node()" />
        -->
        <ModValue Insert="$honoured_guest_visit_multiplier * self::node()" />
    </ModOp>

    <!-- Honoured Guest Heroic Percent Chance Per Splendor Stage (Default = 2%) -->
    <ModOp Merge="@173079/VisitorsConfig/VisitorPools/Item/BaseChanceFromSplendorStages">
        <ModValue Insert="$honoured_guest_heroic_percent_chance_per_splendor_stage" />
    </ModOp>

</ModOps>

